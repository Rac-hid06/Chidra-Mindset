# ============================================================
# CHIDRA MINDSET — Variables d'Environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE JAMAIS versionner le fichier .env dans Git.
# ============================================================

# Port d'écoute du serveur Node.js
PORT=5000

# Environnement ('development' ou 'production')
NODE_ENV=production

# Chemin absolu vers la base de données SQLite
# Sur Render/Railway avec disque persistant : /data/chidra.sqlite
# En développement local : laisser vide (défaut : server/data/chidra.sqlite)
DATABASE_PATH=/data/chidra.sqlite

# Domaine autorisé pour les requêtes CORS
# En développement : http://localhost:5173
# En production : https://votre-domaine.com
ALLOWED_ORIGIN=https://chidramindset.com

# Email de l'administrateur principal (utilisé par seed-admin.js)
# IMPORTANT : changer le mot de passe après le premier déploiement
ADMIN_EMAIL=admin@chidramindset.com
ADMIN_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_EN_PRODUCTION
